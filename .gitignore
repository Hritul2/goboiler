# Binaries
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test & coverage
*.test
*.out
coverage.html
coverage.txt

# Go workspace
go.work
go.work.sum

# Environment — never commit real secrets
.env
.env.local
.env.stage
.env.prod

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Air (live reload)
tmp/

# Logs: keep the directory (log/.gitkeep) but none of its contents. Anchored
# so it does not match unrelated directories named "log".
/log/*
!/log/.gitkeep
*.log

# Local config override (copy from configs/config.local.example.json: make setup)
/configs/*.local.json

# Scratch / generated output (Docker volumes, local experiments)
/output/
