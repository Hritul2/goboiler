# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_VERSION=0.0.1

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
# Omit or leave blank to default to "info".
LOG_LEVEL=debug

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Database ─────────────────────────────────────────────────────────────────
# Mongo connection string; the database name is configured separately.
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=twospc
# Postgres (future): DATABASE_URL=postgres://user:password@localhost:5432/twospc?sslmode=disable

# ── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://localhost:4318
OTEL_ENABLED=false
# Fraction of traces to sample: 0.0–1.0 (defaults to 1.0 when omitted)
OTEL_SAMPLE_RATE=1.0

# ── Redis ────────────────────────────────────────────────────────────────────
# Logical DB index is fixed at 0 in configs/*.json.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Works with any SMTP provider (Zoho, Gmail app password, AWS SES SMTP).
# Local testing: run Mailpit (docker compose) and use localhost:1025.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secrets must be at least 32 characters.
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
