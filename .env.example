# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/twospc?sslmode=disable

# ── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://localhost:4318
OTEL_ENABLED=false

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
